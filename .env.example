# ------------------------------------------------------------
# Torrential News - environment variables
# These are set in Vercel (Project > Settings > Environment Variables).
# NEVER put real keys in this file or commit them to GitHub.
# ------------------------------------------------------------

# 1) AI summarization (Anthropic Claude). Required for Newsletter Intake.
ANTHROPIC_API_KEY=

# Optional: override the Claude model. Leave blank to use the default.
ANTHROPIC_MODEL=

# 2) OneDrive / SharePoint company access (OPTIONAL, for later).
# Only needed when your IT admin approves a Microsoft Entra app registration.
# Public "Anyone with the link" OneDrive links work without these.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
